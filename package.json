{
  "name": "modelo-planta-3d",
  "productName": "Modelo 3D de oficina",
  "description": "Plantas en 3D, rutas más cortas e itinerarios del equipo de limpieza.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/copy-ocr.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:file": "tsc --noEmit && vite build --mode file",
    "preview": "vite preview",
    "app": "npm run build:file && electron .",
    "dist:win": "npm run build:file && electron-builder --win nsis"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.176.0",
    "typescript": "~5.8.0",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "local.modelo-planta-3d",
    "productName": "Modelo 3D de oficina",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist-file/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Modelo 3D de oficina",
      "artifactName": "Modelo-3D-oficina-Setup-${version}.exe"
    }
  }
}
